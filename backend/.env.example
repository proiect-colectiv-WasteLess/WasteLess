# Copy to .env for Docker Compose; Spring Boot itself does not load .env.
DB_URL=jdbc:postgresql://localhost:5432/wasteless
DB_USERNAME=wasteless
DB_PASSWORD=replace-with-local-password
JWT_SECRET=replace-with-random-secret-of-at-least-32-bytes
JWT_TTL_SECONDS=3600
CORS_ALLOWED_ORIGINS=http://localhost:3000